# Root .gitignore for Sudarshan Hingalje Portfolio Monorepo

# Ignore environment variables / secrets
.env
.env.*
**/.env
**/.env.*

# Ignore dependency directories
node_modules/
**/node_modules/

# Ignore production builds
dist/
**/dist/
target/
**/target/

# Ignore IDE settings & OS files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Ignore Vercel & Netlify configs
.vercel/
**/.vercel/
.netlify/
**/.netlify/
